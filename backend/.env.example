DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/llmobs
INFERSCOPE_URL=http://ingestion:8081
# event bus — docker uses the service name; local non-docker runs use redis://localhost:6379
REDIS_URL=redis://redis:6379
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
GOOGLE_API_KEY=your_key
GROQ_API_KEY=your_key

# chatbot
SYSTEM_PROMPT=You are a helpful assistant.
MAX_TURNS=10

# chatbot + dashboard — comma-separated browser origins allowed via CORS
CORS_ORIGINS=http://localhost:3000

# logging
LOG_LEVEL=INFO
